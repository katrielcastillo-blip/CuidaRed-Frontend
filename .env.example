# .env.example — Variables de entorno del frontend de CuidaRed (SRS §11 "Configuración de variables de entorno").
# © 2026 Equipo CuidaRed – INTEC. Todos los derechos reservados.
#
# Copia este archivo como `.env.local` (ignorado por git) y completa los valores. NUNCA subas claves reales
# al repositorio (SRS §8.2.2.3.5 f). Vite solo expone al navegador las variables que empiezan por VITE_.
#
# Esta versión es SOLO FRONTEND: los datos se simulan en el navegador y ninguna de estas variables es
# obligatoria todavía. Quedan reservadas para conectar el backend previsto por el SRS (Node.js + Express
# con Supabase) sin cambiar el código de las pantallas.

# URL base de la API REST (Express). Desarrollo: http://localhost:3000 · Producción: solo HTTPS (puerto 443).
VITE_API_URL=http://localhost:3000

# Proyecto de Supabase (la clave "anon" es pública por diseño; la "service_role" JAMÁS va en el frontend).
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave-anon-publica>

# Minutos de inactividad antes de cerrar la sesión (por defecto 30).
VITE_SESION_MINUTOS_INACTIVIDAD=30
