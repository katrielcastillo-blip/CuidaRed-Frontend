{
  "name": "cuidared-frontend",
  "version": "1.0.0",
  "description": "CuidaRed: PWA mobile-first para el seguimiento comunitario de adultos mayores vulnerables en la República Dominicana (frontend).",
  "author": "Equipo CuidaRed - INTEC",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "PENDIENTE: URL del repositorio del equipo (Azure DevOps)"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verificar:cache": "node scripts/verificar-cache.mjs",
    "verificar:offline": "node scripts/verificar-offline.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:componentes": "vitest run",
    "test:access": "playwright test --config playwright.access.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "chart.js": "^4.6.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.53.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "vite-plugin-pwa": "^2.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
